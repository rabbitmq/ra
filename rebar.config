{deps, [
        {gen_batch_server, "0.10.0"},
        {aten, "0.6.0"},
        {seshat, "1.0.1"}
]}.

{profiles,
 [{test, [{deps, [proper,
                  meck,
                  {inet_tcp_proxy_dist,
                   {git, "https://github.com/rabbitmq/inet_tcp_proxy",
                    {branch, "master"}}}
                 ]}]}
 ]
}.

{dist_node, [
    {sname, 'ra'}
]}.
{project_plugins, [
    rebar3_hex,
    {prisma, "~> 0.2.0"}
]}.
{erl_opts, [debug_info,warn_export_vars,warn_shadow_vars,warn_obsolete_guard]}.
{xref_extra_paths, ["test"]}.
{xref_checks,[undefined_function_calls,
              undefined_functions,
              locals_not_used,
              % exports_not_used,
              deprecated_function_calls,
              deprecated_functions]}.
{hex, [
  {doc, edoc},
  {files, [
    "src",
    "include",
    "rebar.config",
    "rebar.lock",
    "README.md",
    "LICENSE*",
    "ra_*.pplt"
  ]}
]}.
